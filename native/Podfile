source 'https://cdn.cocoapods.org/'

# macOS 12 is the oldest deployment target supported by current Xcode SDKs.
DEPLOYMENT_TARGET = '12.0'

platform :osx, DEPLOYMENT_TARGET
workspace 'eqMac.xcworkspace'
# Static linkage: pods are linked into the app binary instead of being embedded as
# separate dynamic frameworks. With the hardened runtime, dyld only loads dynamic
# libraries signed by the app's own Team ID, and ad-hoc-signed local builds have no
# Team ID, so embedded dynamic frameworks are refused at launch.
use_frameworks! :linkage => :static

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = DEPLOYMENT_TARGET
      # Pods are built from source as part of the app, so let them inherit
      # the app's (ad-hoc) signing instead of requiring a team.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end

# ignore all warnings from all pods
inhibit_all_warnings!

project 'app/eqMac.xcodeproj'

# Removed from upstream for this fork:
#  - Sparkle: its feed points at the official eqMac update server and would
#    replace this fork with the official build.
#  - Sentry: would send crash reports to the original developer.
#  - SwiftHTTP, Zip: only used to download and unpack the remotely hosted UI.
#  - SwiftLint: not used by any build phase.
target 'eqMac' do
  project 'app/eqMac.xcodeproj'

  # The bitgapp/AMCoreAudio fork this depends on was deleted from GitHub; it is vendored here.
  pod 'AMCoreAudio', :path => 'vendor/AMCoreAudio'
  pod 'WebViewJavascriptBridge', '~> 6.0'
  pod 'ReSwift', '~> 6.1'
  pod 'EmitterKit', '~> 5.2.2'
  pod 'SwiftyJSON', '~> 4.2'
  pod 'SwiftyUserDefaults', '4.0'
  pod 'KeychainSwift', '~> 13.0'
  pod 'STPrivilegedTask', :git => 'https://github.com/sveinbjornt/STPrivilegedTask.git', :commit => 'fdca677c77adb166a2be4c5ea9c7580a738c49c9'
end
